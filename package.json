{
    "name": "@softtynet/zca-js",
    "version": "2.3.10",
    "description": "Zalo API client library for Node.js and Bun, maintained by Softtynet.",
    "main": "dist/cjs/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "index.d.ts",
        "LICENSE",
        "README.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/cjs/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "prebuild": "node scripts/buildAPI.js",
        "build:clean": "rimraf dist",
        "build:esm": "tsc",
        "build:cjs": "rollup -c rollup.config.js",
        "build": "npm run build:clean && npm run build:esm && npm run build:cjs",
        "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit && tsc -p docs/tsconfig.json --noEmit",
        "test:verify": "npm run typecheck && npx --yes tsx test/verify_upgrades.ts",
        "test:live": "npx --yes tsx test/verify_live.ts",
        "test:call-studio": "npm run build && npx --yes tsx test/call_studio_server.ts",
        "test:oa-studio": "npm run build && npx --yes tsx test/oa_studio_server.ts",
        "docs:gen": "node scripts/generateDocs.js",
        "docs:dev": "node scripts/generateDocs.js && vitepress dev docs",
        "docs:build": "node scripts/generateDocs.js && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "docs:deploy": "node scripts/deployDocs.js",
        "prettier": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/softtyos/zca-js.git"
    },
    "homepage": "https://github.com/softtyos/zca-js",
    "bugs": {
        "url": "https://github.com/softtyos/zca-js/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "zalo",
        "zalo-api",
        "zca-js",
        "softtynet",
        "chatbot"
    ],
    "author": "Softtynet Co., Ltd. (Based on zca-js by RFS-ADRENO)",
    "license": "MIT",
    "dependencies": {
        "crypto-js": "^4.2.0",
        "form-data": "^4.0.4",
        "json-bigint": "^1.0.0",
        "pako": "^2.1.0",
        "semver": "^7.6.3",
        "spark-md5": "^3.0.2",
        "tough-cookie": "^5.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@types/bun": "^1.1.14",
        "@types/crypto-js": "^4.2.2",
        "@types/json-bigint": "^1.0.4",
        "@types/node": "^20.14.10",
        "@types/pako": "^2.0.3",
        "@types/semver": "^7.5.8",
        "@types/spark-md5": "^3.0.4",
        "@types/ws": "^8.5.11",
        "eslint": "^9.34.0",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.5",
        "mermaid": "^12.2.0",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.10",
        "rollup": "^4.24.0",
        "typescript": "^5.5.3",
        "typescript-eslint": "^8.41.0",
        "vitepress": "^1.6.4"
    },
    "lint-staged": {
        "*.{js,ts}": "eslint"
    }
}
